{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:scout:assay-label-packet:v1",
  "title": "Assay blind relevance packet v1",
  "type": "object",
  "required": ["format", "name", "sitting", "digest", "plan_digest", "rubric", "cases"],
  "properties": {
    "format": {"const": "assay.label-packet/v1"},
    "name": {"type": "string"},
    "sitting": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric": {"type": "array"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "text", "parent_text"],
        "properties": {
          "case_id": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "parent_text": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
