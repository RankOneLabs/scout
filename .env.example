# Discord bot token (requires MESSAGE_CONTENT intent enabled in Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenRouter API key (required when any model starts with openrouter/)
OPENROUTER_API_KEY=your_openrouter_api_key

# Discord server (guild) ID to scan
DISCORD_SERVER_ID=123456789

# Comma-separated channel IDs to monitor
DISCORD_CHANNEL_IDS=111111111,222222222

# --- Farcaster (Neynar) ---
# Get a free API key at https://dev.neynar.com
NEYNAR_API_KEY=your_neynar_api_key
NEYNAR_API_URL=https://api.neynar.com/v2/farcaster

# Farcaster channels to monitor (optional, comma-separated)
# e.g. ethereum,base,farcaster,dev
FARCASTER_CHANNEL_IDS=

# Required for `scout content publish` to Farcaster. Set after one-time
# Neynar managed-signer approval. See README "Content engine" for setup.
FARCASTER_SIGNER_UUID=

# Required only during one-time signer registration (EIP-712 SignedKeyRequest).
# Once a signer is approved, no code path consumes this value. Treat like a
# wallet seed phrase regardless.
FARCASTER_DEVELOPER_MNEMONIC=

# --- Bluesky (AT Protocol) ---
# Search queries are derived from target project keywords
# Uses bsky.social for both auth and search (not public.api.bsky.app)
BLUESKY_API_URL=https://bsky.social/xrpc
# App password auth (Settings > App Passwords on bsky.app)
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Comma-separated feed URIs to monitor (optional)
# e.g. at://did:plc:xxx/app.bsky.feed.generator/my-feed
BLUESKY_FEED_URIS=
# Comma-separated Bluesky language tags to keep. Search uses the first tag
# upstream; local filtering keeps posts with missing language metadata.
BLUESKY_LANGS=en

# --- Tuning ---
# How often to scan (hours) - only used in continuous mode
SCAN_INTERVAL_HOURS=6

# Minimum relevance score to include in digest (0.0-1.0)
RELEVANCE_THRESHOLD=0.7

# Models routed via jig's `from_model`:
#   claude-*          -> Anthropic (needs ANTHROPIC_API_KEY)
#   openrouter/<vendor>/<slug> -> OpenRouter (needs OPENROUTER_API_KEY)
#   dispatch/<name>   -> dispatch service (configure DISPATCH_URL)
#   ollama/<name>     -> local Ollama server
# LLM_MODEL is the fallback for any phase model left unset.
LLM_MODEL=claude-sonnet-4-6
RELEVANCE_MODEL=
REPLY_DRAFT_MODEL=
CRITIC_MODEL=
# Optional deployment-local preflight identity/policy JSON. Unset defaults to two families.
# Exact aliases are metadata declarations, not routing overrides. Keep real mappings in .env.
# SCOUT_MODEL_IDENTITY_CONFIG={"policy":{"minimum_families":2},"identities":[{"model":"dispatch/reviewer","developer":"moonshotai","family":"kimi"}]}

# SQLite database paths
DB_PATH=scout.db
TRACE_DB_PATH=scout_traces.db
FEEDBACK_DB_PATH=scout_feedback.db

# Max messages to fetch per channel per scan
MAX_MESSAGES_PER_CHANNEL=200

# Max Farcaster/Bluesky results fetched for each platform search/feed request
FARCASTER_MAX_RESULTS_PER_QUERY=25
BLUESKY_MAX_RESULTS_PER_QUERY=25

# Max new, previously unseen live-scan messages to evaluate after platform fetch + dedupe.
# Set to 0 to disable the scan-level cap.
SCAN_MAX_NEW_MESSAGES=300

# Use keyword prefilter before LLM evaluation (saves API costs)
KEYWORD_PREFILTER=true

# --- Non-gating typesafe shadow relevance ---
TYPESAFE_SHADOW_MODE=false
TYPESAFE_SHADOW_BACKEND=placeholder
# Required when TYPESAFE_SHADOW_MODE=true.
TYPESAFE_PLACEHOLDER_ANSWERS_PATH=

# --- Relevance classifier ---
# Which classifier decides relevance: llm (default, and the rollback path) or
# jev (Typesafe System One plus the ported router). Exactly one runs.
# Rollback is this one variable: every setting below is validated only under
# jev, so a rolled-back deployment cannot fail startup on one it no longer
# uses. Pending holds survive the rollback and still release on the action
# recorded at decision time. See docs/relevance-holdouts.md.
RELEVANCE_CLASSIFIER=llm
# Required when RELEVANCE_CLASSIFIER=jev. Also read by the shadow node.
TYPESAFE_API_KEY=
# Defaults to https://api.typesafe.ai.
TYPESAFE_BASE_URL=
# The feature catalogue. Under RELEVANCE_CLASSIFIER=jev this must be set
# explicitly to the private v6 catalogue's mounted path — the shadow node's
# packaged default is a different document shape and the JEV loader rejects it.
TYPESAFE_CATALOGUE_PATH=
# Probability a decided post is held back from surfacing for blind grading —
# drops included, because the holdout population is the decision population.
# A held post gets its evaluation and stops: no draft, no critic, no surface,
# until `scout holdout release` acts on it. 0 holds nothing, 1 holds
# everything, and a value outside [0, 1] fails startup.
# Independent of RELEVANCE_CLASSIFIER: this is read whatever is classifying,
# so rolling back to llm neither resets it nor stops sampling. Set it to 0 if
# sampling should stop too.
RELEVANCE_HOLDOUT_RATE=0.1

# --- Dossier grounding ---
# Deployment provenance written to every scan. Production evidence only accepts
# SCOUT_ENVIRONMENT=production scans with run_kind=live.
SCOUT_ENVIRONMENT=development

# Path to the read-only dossier-source checkout (required for scan).
# Mount as read-only in production containers.
SCOUT_DOSSIER_ROOT=/path/to/dossier-source

# Minimum total facts+resources a dossier must have to be considered ready.
# Must be >= 20 (Phase 1-safe default: 20).
SCOUT_DOSSIER_MIN_ENTRIES=20

# Maximum age in days since last_reviewed before a dossier is stale.
# Must be >= 1 (default: 90 days).
SCOUT_DOSSIER_MAX_AGE_DAYS=90

# Maximum surfaced replies to a single author in a rolling 7×24h window.
# Must be >= 1 (default: 1).
SCOUT_AUTHOR_WEEKLY_CAP=1

# --- Owned scan lifecycle and lease-based recovery ---
# TTL (seconds) a canonical live owner's environment lease is granted for on
# acquire, and extended to on each heartbeat renewal. Must be >= 5.
SCOUT_LEASE_TTL_SECONDS=120

# Interval (seconds) between heartbeat renewals of an already-acquired lease.
# Must leave room for at least 2 missed heartbeats within SCOUT_LEASE_TTL_SECONDS.
SCOUT_LEASE_HEARTBEAT_SECONDS=30

# TTL (seconds) of the exclusive recovery lock `scout watermark probe/backfill/
# cutover` hold for the duration of one operator-driven invocation.
SCOUT_RECOVERY_LOCK_TTL_SECONDS=1800

# How recent (seconds) a passed six-hour probe must be to gate a controlled
# `scout watermark cutover`.
SCOUT_CUTOVER_PROBE_MAX_AGE_SECONDS=3600

# Bounded-backfill page ceiling per source, independent of each platform
# client's own normal per-scan page limits.
SCOUT_BACKFILL_MAX_PAGES_PER_SOURCE=20

# A canonical live watermark older than this (hours) is reported stale by
# `scout watermark stale-check`. Exact-environment scoped only.
SCOUT_STALE_WATERMARK_HOURS=24

# --- Content engine (outbound) ---
# Default platforms `scout content publish` fans out to when --channels is
# omitted at intake. Comma-separated; supported values: bluesky,farcaster.
OUTBOUND_PLATFORMS=bluesky,farcaster

# Cadence targets in calendar days for `scout content status` next-post-due.
# Drop a `cadence.toml` at the repo root with [targets] technical_days /
# synthesis_days to override these without editing the environment.
CONTENT_CADENCE_TECHNICAL_DAYS=14
CONTENT_CADENCE_SYNTHESIS_DAYS=30
